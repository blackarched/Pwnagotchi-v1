# Stage 1: Build the React application
FROM node:18-alpine AS builder

WORKDIR /app

# Copy package.json and package-lock.json (or yarn.lock or pnpm-lock.yaml)
COPY package*.json ./
# If you have a private NPM registry or need SSH access for git dependencies:
# ARG NPM_TOKEN
# RUN echo "//registry.npmjs.org/:_authToken=${NPM_TOKEN}" > .npmrc
# Or for SSH:
# RUN mkdir -p -m 0700 ~/.ssh && ssh-keyscan github.com >> ~/.ssh/known_hosts

# Install dependencies
# Using npm ci for reproducible builds if package-lock.json is present and up-to-date
RUN npm ci

# Copy the rest of the application source code
COPY . .

# Set build arguments for Vite if needed (e.g., VITE_API_URL)
# These should be passed during the `docker build` command, e.g., --build-arg VITE_API_URL=http://example.com/api
ARG VITE_API_URL
ARG VITE_WS_URL
ARG VITE_WEBSOCKET_PATH

ENV VITE_API_URL=${VITE_API_URL}
ENV VITE_WS_URL=${VITE_WS_URL}
ENV VITE_WEBSOCKET_PATH=${VITE_WEBSOCKET_PATH}

# Build the application
# The build script in package.json is "node tools/generate-llms.js || true && vite build"
# We should ensure `tools/generate-llms.js` runs correctly or is handled.
# The `|| true` suggests it might be optional or fail gracefully.
RUN npm run build

# Stage 2: Serve the application with Nginx
FROM nginx:1.25-alpine AS production

# Remove default Nginx server configuration
RUN rm /etc/nginx/conf.d/default.conf

# Copy the custom Nginx configuration (assuming it's in the frontend directory)
COPY nginx.conf /etc/nginx/conf.d/default.conf
# If nginx.conf references other files like SSL certs, they also need to be handled.
# For this setup, we're assuming nginx.conf is self-contained or certs are mounted via Docker volumes/K8s secrets.

# Copy the built static assets from the builder stage
COPY --from=builder /app/dist /usr/share/nginx/html

# Expose port 80 (or whatever port Nginx is configured to listen on in nginx.conf)
EXPOSE 80

# Command to run Nginx in the foreground
CMD ["nginx", "-g", "daemon off;"]
