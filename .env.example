# =================================================
# PWNAGOTCHI DASHBOARD - ENVIRONMENT CONFIGURATION
# =================================================
# Copy this file to .env and fill in your values.

# --- Pwnagotchi Connection Details ---
# Used by the backend to connect to your Pwnagotchi device.
# If using SSH, ensure the backend server has SSH access to the Pwnagotchi.
PWNAGOTCHI_HOST=your_pwnagotchi_ip_or_hostname
PWNAGOTCHI_PORT=22
PWNAGOTCHI_USER=pi
PWNAGOTCHI_SSH_KEY_PATH=/path/to/your/ssh/private_key_for_pwnagotchi # e.g., ~/.ssh/id_rsa_pwnagotchi

# Optional: If your Pwnagotchi exposes a direct HTTP API (e.g., via a plugin)
PWNAGOTCHI_API_BASE_URL=http://your_pwnagotchi_ip_or_hostname:8080/api/v1 # Example URL

# Optional: For testing with a mock Pwnagotchi server
# MOCK_PWNAGOTCHI_API_URL=http://localhost:8888/mock-api/v1
# MOCK_PWNAGOTCHI_CLI_URL=http://localhost:8888/mock-cli

# --- Backend Server Configuration ---
BACKEND_PORT=3001                     # Port the backend Express server will listen on.
CORS_ORIGIN=http://localhost:5173     # Allowed frontend URL(s) for CORS (comma-separated for multiple). Use '*' for all, but be cautious in production.
LOG_LEVEL=info                        # Logging level for the backend (error, warn, info, debug, silly).
WEBSOCKET_PATH=/socket.io             # Path for Socket.IO connections (must match frontend).
ENABLE_METRICS=true                   # Set to 'true' to enable the /metrics endpoint for Prometheus.
NODE_ENV=development                  # Node environment (development or production).

# --- Rate Limiting (for backend API) ---
RATE_LIMIT_WINDOW_MS=900000           # Time window for rate limiting in milliseconds (e.g., 15 * 60 * 1000 = 15 minutes).
RATE_LIMIT_MAX_REQUESTS=100           # Max number of requests allowed per IP within the window.

# --- Redis Configuration ---
# Used for caching data fetched from Pwnagotchi and potentially for session management.
REDIS_URL=redis://localhost:6379      # Connection URL for your Redis instance. (e.g., redis://username:password@host:port)

# --- Pwnagotchi Polling Configuration (Backend) ---
# Interval in milliseconds for the backend to poll the Pwnagotchi for updates (if not using WebSockets for all data).
PWNAGOTCHI_POLL_INTERVAL_MS=5000      # Default: 5 seconds. Set to 0 to disable polling if not needed.
ENABLE_PWNAGOTCHI_POLLING=true        # Set to 'true' to enable the Pwnagotchi data polling loop in server.js

# =================================================
# FRONTEND - BUILD-TIME & RUNTIME CONFIGURATION
# =================================================
# These variables are typically set in `frontend/.env` for Vite.
# They are listed here for comprehensive documentation.

# VITE_APP_TITLE=Pwnagotchi Dashboard
# VITE_API_URL=http://localhost:3001/api   # Base URL for API calls from frontend (proxied by Vite dev server or Nginx in prod).
                                         # If served under a subpath, ensure this reflects it e.g. /dashboard/api
# VITE_WS_URL=ws://localhost:3001          # WebSocket URL for frontend (matching backend host/port).
# VITE_WEBSOCKET_PATH=/socket.io           # WebSocket path for frontend (must match WEBSOCKET_PATH on backend).
[end of .env.example]
