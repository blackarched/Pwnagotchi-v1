# Pwnagotchi Connection Details
PWNAGOTCHI_HOST=
PWNAGOTCHI_PORT=22
PWNAGOTCHI_USER=pi
PWNAGOTCHI_SSH_KEY_PATH=/home/user/.ssh/pwnagotchi_rsa
PWNAGOTCHI_API_BASE_URL=http://localhost:8666/api/v1 # Example if pwnagotchi has a local API accessible to the backend

# Redis Configuration
REDIS_URL=redis://redis:6379

# Backend Configuration
BACKEND_PORT=3001
CORS_ORIGIN=http://localhost:8080,http://localhost:5173 # Allow default Vite dev port
NODE_ENV=development
LOG_LEVEL=info
WEBSOCKET_PATH=/socket.io

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000 # 15 minutes
RATE_LIMIT_MAX_REQUESTS=100

# Frontend Configuration (these are build-time variables for Vite)
VITE_API_URL=http://localhost:3001/api
VITE_WS_URL=ws://localhost:3001
VITE_WEBSOCKET_PATH=/socket.io
